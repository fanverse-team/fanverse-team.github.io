rules_version = '2';

// FANVERSE Firestore 安全規則
// 原則：預設全部拒絕；只開放必要的讀寫；每個欄位都驗證型別與長度；
// 實名資料（姓名、生日）只有本人讀得到，姓名只能由本人逐一揭露給特定對象。
// 身分證字號不會出現在任何文件中（只在使用者裝置上檢查格式）。

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- 共用函式 ----------
    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function me() { return request.auth.uid; }
    function myProfile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function hasProfile() { return exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function isMinor() { return myProfile().minor == true; }
    function str(v, lo, hi) { return v is string && v.size() >= lo && v.size() <= hi; }
    function concertOk(c) { return c is string && c.matches('^e[0-9]{2,4}$'); }
    function unchanged(field) { return request.resource.data[field] == resource.data[field]; }

    // 年齡判斷採保守算法：18 年 = 6575 天（含最多 5 個閏日），寧可多算一天未成年
    function adultBy(birthday) { return request.time >= birthday + duration.value(6575, 'd'); }
    function atLeast13(birthday) { return request.time >= birthday + duration.value(4752, 'd'); }

    // ---------- 公開檔案：暱稱、性別、年齡區間、實名徽章 ----------
    function validPublic(d) {
      return d.keys().hasOnly(['nickname', 'gender', 'ageBand', 'minor', 'verified', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['nickname', 'gender', 'ageBand', 'minor', 'verified', 'createdAt', 'updatedAt'])
        && str(d.nickname, 1, 20)
        && d.gender in ['男', '女']
        && d.minor is bool
        && d.verified == 'id-format'
        && ((d.minor == true && d.ageBand == '') || (d.minor == false && d.ageBand in ['18–24', '25–34', '35–44', '45+']))
        && d.updatedAt == request.time;
    }
    // 公開檔案的未成年標記必須和私密生日一致
    function minorMatches(d, priv) { return d.minor == !adultBy(priv.birthday); }

    match /users/{uid} {
      // 只能「一筆一筆」看（get），不能整批列出（list），避免有人一次撈出所有會員或篩出未成年帳號
      allow get: if verified();
      allow list: if false;
      allow create: if verified() && me() == uid
        && validPublic(request.resource.data)
        && request.resource.data.createdAt == request.time
        && existsAfter(/databases/$(database)/documents/private/$(uid))
        && minorMatches(request.resource.data, getAfter(/databases/$(database)/documents/private/$(uid)).data);
      allow update: if verified() && me() == uid
        && validPublic(request.resource.data)
        && unchanged('createdAt') && unchanged('gender') && unchanged('verified')
        && minorMatches(request.resource.data, get(/databases/$(database)/documents/private/$(uid)).data);
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- 私密實名資料：只有本人能讀寫；姓名與生日建立後不可修改 ----------
    function validPrivate(d) {
      return d.keys().hasOnly(['realName', 'birthday', 'guardianConsent', 'consentVersion', 'consentAt', 'idCheckedAt'])
        && d.keys().hasAll(['realName', 'birthday', 'guardianConsent', 'consentVersion', 'consentAt', 'idCheckedAt'])
        && str(d.realName, 2, 30)
        && d.birthday is timestamp
        && atLeast13(d.birthday)
        && d.guardianConsent is bool
        && (adultBy(d.birthday) || d.guardianConsent == true)
        && d.consentVersion == 'v1'
        && d.consentAt is timestamp
        && d.idCheckedAt is timestamp;
    }

    match /private/{uid} {
      allow read: if signedIn() && me() == uid;
      allow create: if verified() && me() == uid && validPrivate(request.resource.data);
      allow update: if verified() && me() == uid && validPrivate(request.resource.data)
        && unchanged('realName') && unchanged('birthday');
      allow delete: if signedIn() && me() == uid;
    }

    // ---------- 實名揭露：本人把自己的姓名揭露給「單一」對象 ----------
    match /reveals/{owner}/to/{viewer} {
      allow read: if signedIn() && (me() == owner || me() == viewer);
      allow create: if verified() && me() == owner && owner != viewer
        && !isMinor()
        && request.resource.data.keys().hasOnly(['realName', 'createdAt'])
        && request.resource.data.realName == get(/databases/$(database)/documents/private/$(owner)).data.realName
        && request.resource.data.createdAt == request.time;
      allow delete: if signedIn() && me() == owner;
    }

    // ---------- 自己的申請索引（只有本人讀寫） ----------
    match /myRequests/{uid}/items/{itemId} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if verified() && me() == uid
        && request.resource.data.keys().hasOnly(['type', 'targetId', 'createdAt'])
        && request.resource.data.type in ['ride', 'trade']
        && str(request.resource.data.targetId, 1, 64)
        && itemId == request.resource.data.type + '_' + request.resource.data.targetId
        && request.resource.data.createdAt == request.time;
    }

    // ---------- 同行媒合 ----------
    function validRide(d) {
      return d.keys().hasOnly(['kind', 'concertId', 'title', 'from', 'capacity', 'cost', 'note', 'owner', 'createdAt', 'memberCount', 'day'])
        && d.keys().hasAll(['kind', 'concertId', 'title', 'from', 'capacity', 'cost', 'note', 'owner', 'createdAt', 'memberCount'])
        && d.kind in ['包車', '住宿', '旅伴']
        && concertOk(d.concertId)
        && str(d.title, 1, 40)
        && str(d.from, 1, 30)
        && d.capacity is int && d.capacity >= 2 && d.capacity <= 50
        && d.cost is int && d.cost >= 0 && d.cost <= 20000
        && str(d.note, 0, 120)
        && d.memberCount is int && d.memberCount >= 0 && d.memberCount < d.capacity
        && (!('day' in d) || (d.day is string && d.day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$')));
    }
    function ride(rideId) { return get(/databases/$(database)/documents/rides/$(rideId)).data; }

    // 發文冷卻：每個帳號每 30 秒只能新增一篇媒合或交換貼文，防止洗版
    function coolRef() { return /databases/$(database)/documents/cool/$(request.auth.uid); }
    function coolOk() {
      return getAfter(coolRef()).data.at == request.time
        && (!exists(coolRef()) || get(coolRef()).data.at < request.time - duration.value(30, 's'));
    }
    match /cool/{uid} {
      allow get: if signedIn() && me() == uid;
      allow create, update: if verified() && me() == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
      allow delete: if signedIn() && me() == uid;
    }

    match /rides/{rideId} {
      allow read: if verified();
      allow create: if verified() && hasProfile()
        && validRide(request.resource.data)
        && request.resource.data.owner == me()
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberCount == 0
        && (request.resource.data.kind != '住宿' || !isMinor())
        && coolOk();
      allow update: if verified() && resource.data.owner == me()
        && validRide(request.resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount', 'title', 'note']);
      allow delete: if verified() && resource.data.owner == me();

      // 申請：只有申請者本人與發起人看得到，其他人看不到誰申請了哪一團
      match /requests/{uid} {
        allow read: if verified() && (me() == uid || ride(rideId).owner == me());
        allow create: if verified() && hasProfile() && me() == uid
          && ride(rideId).owner != me()
          && (ride(rideId).kind != '住宿' || !isMinor())
          && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt'])
          && request.resource.data.uid == me()
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if verified() && ride(rideId).owner == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'];
        allow delete: if verified() && (me() == uid || ride(rideId).owner == me());
      }

      // ---------- 團體空間：只有發起人與「已接受」的成員能進 ----------
      function isMember() {
        return ride(rideId).owner == me()
          || get(/databases/$(database)/documents/rides/$(rideId)/requests/$(me())).data.status == 'accepted';
      }
      function lastRef() { return /databases/$(database)/documents/rides/$(rideId)/chatLast/$(me()); }

      // 聊天訊息：每則最多 300 字；同一人兩則訊息至少間隔 2 秒（靠 chatLast 檢查）
      match /chat/{msgId} {
        allow read: if verified() && (isMember() || resource.data.uid == me());
        allow create: if verified() && hasProfile() && isMember()
          && request.resource.data.keys().hasOnly(['uid', 'text', 'createdAt'])
          && request.resource.data.keys().hasAll(['uid', 'text', 'createdAt'])
          && request.resource.data.uid == me()
          && str(request.resource.data.text, 1, 300)
          && request.resource.data.createdAt == request.time
          && getAfter(lastRef()).data.at == request.time
          && (!exists(lastRef()) || get(lastRef()).data.at < request.time - duration.value(2, 's'));
        allow delete: if verified() && (resource.data.uid == me() || ride(rideId).owner == me());
      }
      match /chatLast/{uid} {
        allow read: if verified() && me() == uid;
        allow create, update: if verified() && me() == uid && isMember()
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow delete: if signedIn() && (me() == uid || ride(rideId).owner == me());
      }

      // meta/plan：共用行程，發起人設定、成員只能看
      // meta/last：最新訊息時間（給未讀提醒用），成員發訊息時一起更新
      match /meta/{docId} {
        allow read: if verified() && isMember();
        allow create, update: if verified() && docId == 'last' && isMember()
          && request.resource.data.keys().hasOnly(['at'])
          && request.resource.data.at == request.time;
        allow create, update: if verified() && ride(rideId).owner == me() && docId == 'plan'
          && request.resource.data.keys().hasOnly(['from', 'mode', 'stay', 'budget', 'dateIdx', 'updatedAt'])
          && request.resource.data.keys().hasAll(['from', 'mode', 'stay', 'budget', 'dateIdx', 'updatedAt'])
          && request.resource.data.from in ['北北基', '桃園', '新竹苗栗', '台中彰化', '雲林嘉義', '台南', '高雄屏東', '宜蘭花東']
          && request.resource.data.mode in ['高鐵', '台鐵', '客運', '包車共乘', '自行開車']
          && request.resource.data.stay in ['自動判斷', '當天來回', '住一晚']
          && request.resource.data.budget in ['省錢', '適中', '享受']
          && request.resource.data.dateIdx is int && request.resource.data.dateIdx >= 0 && request.resource.data.dateIdx < 40
          && request.resource.data.updatedAt == request.time;
        allow delete: if verified() && ride(rideId).owner == me();
      }
    }

    // ---------- 同場次佔位：同一場演出的同一天，包車和住宿各只能確認一團 ----------
    // 由發起人在「發起」或「接受」時一起寫入；已經有紀錄就不能再建立，所以無法同時確認兩團
    function seatKeyOf(r) { return r.concertId + '_' + (('day' in r) ? r.day : 'x') + '_' + (r.kind == '包車' ? 'bus' : 'stay'); }
    function seatOk(uid, key, r, rideId) {
      return r.kind in ['包車', '住宿'] && key == seatKeyOf(r) && r.owner == me()
        && (uid == me() || getAfter(/databases/$(database)/documents/rides/$(rideId)/requests/$(uid)).data.status == 'accepted');
    }
    match /seats/{uid}/k/{key} {
      allow read: if signedIn() && me() == uid;
      allow create: if verified()
        && request.resource.data.keys().hasOnly(['rideId', 'at'])
        && request.resource.data.keys().hasAll(['rideId', 'at'])
        && str(request.resource.data.rideId, 1, 64)
        && request.resource.data.at == request.time
        && seatOk(uid, key, getAfter(/databases/$(database)/documents/rides/$(request.resource.data.rideId)).data, request.resource.data.rideId);
      allow delete: if signedIn() && (me() == uid || resource == null || ride(resource.data.rideId).owner == me());
    }

    // ---------- 會員回報：每人每場每個項目一筆，內容只能是固定格式 ----------
    // 文件編號 = 回報者 uid + '_' + 項目（+ '_' + 場次日期），所以一個人無法灌票
    function fixOk(cid, rid, d) {
      return concertOk(cid)
        && d.keys().hasOnly(['f', 'day', 'v', 'at']) && d.keys().hasAll(['f', 'day', 'v', 'at'])
        && d.at == request.time && d.v is string && d.day is string
        && rid == me() + '_' + d.f + (d.day == '' ? '' : '_' + d.day)
        && ((d.f == 'time' && d.day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') && d.v.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'))
          || (d.f == 'status' && d.day.matches('^20[0-9]{2}-[0-9]{2}-[0-9]{2}$') && d.v in ['延期', '取消', '照常'])
          || (d.f == 'price' && d.day == '' && d.v.matches('^[0-9]{2,6}-[0-9]{2,6}$'))
          || (d.f == 'platform' && d.day == '' && d.v in ['拓元售票', 'KKTIX', '遠大售票 Ticket Plus', 'ibon 售票', '寬宏售票', '年代售票']));
    }
    match /fixes/{cid}/r/{rid} {
      allow read: if true;
      allow create, update: if verified() && hasProfile() && fixOk(cid, rid, request.resource.data);
      allow delete: if signedIn() && rid.split('_')[0] == me();
    }
    match /myFixes/{uid}/k/{key} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if verified() && me() == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // ---------- 自己參與過的聊天室索引（刪除帳號時用來清掉自己的發言） ----------
    match /myChats/{uid}/rides/{rideId} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if verified() && me() == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at == request.time;
    }

    // ---------- 檢舉：只能新增，任何人都讀不到（管理員在 Firebase 後台查看） ----------
    match /reports/{reportId} {
      allow create: if verified() && hasProfile()
        && reportId == me() + '_' + request.resource.data.msgId
        && request.resource.data.keys().hasOnly(['by', 'rideId', 'msgId', 'who', 'text', 'reason', 'createdAt'])
        && request.resource.data.keys().hasAll(['by', 'rideId', 'msgId', 'who', 'text', 'reason', 'createdAt'])
        && request.resource.data.by == me()
        && str(request.resource.data.rideId, 1, 64) && str(request.resource.data.msgId, 1, 64)
        && str(request.resource.data.who, 0, 128) && str(request.resource.data.text, 0, 300)
        && request.resource.data.reason == '聊天室訊息'
        && request.resource.data.createdAt == request.time;
    }

    // ---------- 周邊交換 ----------
    function validTrade(d) {
      return d.keys().hasOnly(['mode', 'category', 'have', 'want', 'price', 'condition', 'concertId', 'tags', 'note', 'img', 'owner', 'createdAt'])
        && d.keys().hasAll(['mode', 'category', 'have', 'want', 'price', 'condition', 'concertId', 'tags', 'note', 'img', 'owner', 'createdAt'])
        && d.mode in ['交換', '出售', '徵求']
        && d.category in ['小卡', '專輯', '應援物', '其他']
        && str(d.have, 0, 50) && str(d.want, 0, 50)
        && (d.mode == '徵求' || d.have.size() > 0)
        && (d.mode == '出售' || d.want.size() > 0)
        && d.price is int && d.price >= 0 && d.price <= 100000
        && d.condition in ['全新', '近全新', '有使用痕跡', '']
        && (d.concertId == '' || concertOk(d.concertId))
        && d.tags is list && d.tags.size() <= 5
        && str(d.note, 0, 100)
        && d.img is string
        && (d.img == '' || (d.img.size() <= 150000 && d.img.matches('^data:image/jpeg;base64,[A-Za-z0-9+/=]+$')));
    }
    function trade(tradeId) { return get(/databases/$(database)/documents/trades/$(tradeId)).data; }

    match /trades/{tradeId} {
      allow read: if verified();
      allow create: if verified() && hasProfile()
        && validTrade(request.resource.data)
        && request.resource.data.owner == me()
        && request.resource.data.createdAt == request.time
        && coolOk();
      allow delete: if verified() && resource.data.owner == me();

      match /interests/{uid} {
        allow read: if verified() && (me() == uid || trade(tradeId).owner == me());
        allow create: if verified() && hasProfile() && me() == uid
          && trade(tradeId).owner != me()
          && request.resource.data.keys().hasOnly(['uid', 'status', 'createdAt'])
          && request.resource.data.uid == me()
          && request.resource.data.status == 'pending'
          && request.resource.data.createdAt == request.time;
        allow update: if verified() && trade(tradeId).owner == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
          && request.resource.data.status in ['accepted', 'declined'];
        allow delete: if verified() && (me() == uid || trade(tradeId).owner == me());
      }
    }

    // 其他所有路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
